{
  "name": "@usespaceui/squishmoji",
  "version": "0.1.0",
  "description": "A dynamic, code-driven SVG squishmoji generator for React applications.",
  "author": {
    "name": "SpaceUI",
    "email": "hello@spaceui.one",
    "url": "https://www.spaceui.one"
  },
  "contributors": [
    {
      "name": "SpaceUI Team",
      "email": "hello@spaceui.one",
      "url": "https://www.spaceui.one"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/usespaceui"
  },
  "license": "MIT",
  "homepage": "https://www.spaceui.one/tools/avatars?type=squishmoji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/squishmoji.git"
  },
  "bugs": {
    "url": "https://github.com/usespaceui/squishmoji/issues",
    "email": "hello@spaceui.one"
  },
  "keywords": [
    "avatars",
    "squishmoji",
    "squish",
    "emoji",
    "blob",
    "svg",
    "procedural",
    "generative",
    "spaceui",
    "react",
    "deterministic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/contracts.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@usespaceui/gradients": "^0.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.0.2",
    "typescript": "^5.7.3"
  }
}
